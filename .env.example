# Gmail IMAP credentials (use an App Password, not your main password)
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Summary delivery
SUMMARY_SEND_TO=you@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Fetch scope: 24h | unread | since_last_run
FETCH_SCOPE=24h

# Cron schedule (default: 6 AM daily) — interpreted in SCHEDULE_TIMEZONE
SCHEDULE_CRON=0 6 * * *

# Timezone for SCHEDULE_CRON (IANA name, e.g. UTC, Asia/Hong_Kong, America/New_York)
SCHEDULE_TIMEZONE=UTC

# LLM — both default to local Ollama; change to swap provider with zero code changes
SCORER_LLM_MODEL=ollama/qwen3.8
SUMMARISER_LLM_MODEL=ollama/qwen3.8
LLM_BASE_URL=http://llm-proxy:4000
# Shared secret between the services and the LiteLLM proxy — change this
LITELLM_MASTER_KEY=change-me
# Per-LLM-call ceilings, seconds. The digest is one long generation.
SCORER_LLM_TIMEOUT=120
SUMMARISER_LLM_TIMEOUT=600
SCORER_RUN_TIMEOUT=3600
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Dashboard URL as seen from your browser (also used in the digest footer)
DASHBOARD_URL=http://localhost:18001

# Pipeline
SUMMARY_TOP_N=20

# DB path inside containers (do not change unless you update docker-compose volumes)
DB_PATH=/data/email_summariser.db
